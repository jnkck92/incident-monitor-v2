# Vorlage für alle benötigten Umgebungsvariablen.
# Kopiere diese Datei nach .env.local und trage die echten Werte ein.
# .env.local wird niemals ins Git eingecheckt.

# API-Key aus DIVERA 24/7: Verwaltung → Einstellungen → Schnittstellen → Accesskey
VITE_DIVERA_API_KEY=

# Basis-URL der DIVERA-Instanz (Standard reicht für DIVERA 24/7 Cloud)
VITE_DIVERA_BASE_URL=https://app.divera247.com

# Abfrage-Intervall in Sekunden (Minimum 20 s empfohlen)
VITE_POLL_INTERVAL_SECONDS=30

# Anzeigename der Wache
VITE_DEPARTMENT_NAME=Feuerwehr Musterstadt
