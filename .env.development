# Entwicklungsumgebung (npm run dev)
# Sensible Werte (API-Key) gehören in .env.local – niemals hier eintragen!

VITE_DIVERA_BASE_URL=https://app.divera247.com
VITE_POLL_INTERVAL_SECONDS=5
VITE_DEPARTMENT_NAME=Feuerwehr Ritterhude Test


VITE_DIVERA_API_KEY=

# Mock-Modus: 'true' = lokale JSON-Datei statt echter API
# Datei wechseln: public/mock/alarm.json ↔ public/mock/no-alarm.json
#VITE_USE_MOCK=true
#VITE_MOCK_FILE=/mock/alarm.json
